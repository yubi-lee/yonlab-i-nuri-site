APP_NAME=YOnLearn Hub
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://yonlearn:yonlearn@localhost:5432/yonlearn
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173

# Demo seed account only. Do not use these values for production access.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# Production administrator bootstrap placeholders.
# Provide real values through a secret manager, shell environment, or one-time operator prompt.
PRODUCTION_ADMIN_EMAIL=operator@example.test
PRODUCTION_ADMIN_INITIAL_PASSWORD=
PRODUCTION_ADMIN_NAME=Production Administrator

UPLOAD_DIR=backend/storage
VITE_API_URL=http://localhost:8000/api/v1
# Optional integration placeholders. Production provider choices are documented as pending decisions.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_PROVIDER_API_KEY=
BACKUP_DESTINATION=local-backups
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_REQUIRED=false
