# YOnLearn Hub production environment template.
# Copy to the server's protected .env location and replace every angle-bracket placeholder.
# Never commit the filled production file.

APP_NAME=YOnLearn Hub
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@postgres:5432/<db_name>
JWT_SECRET=<generate-at-least-32-random-characters>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=https://<production-domain>

# Demo seed account only. Keep disabled/blank for production unless running a controlled demo import.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production administrator bootstrap. Supply the password from a protected secret store or hidden prompt.
PRODUCTION_ADMIN_EMAIL=<operator-email>
PRODUCTION_ADMIN_INITIAL_PASSWORD=
PRODUCTION_ADMIN_NAME=Production Administrator

UPLOAD_DIR=backend/storage
VITE_API_URL=https://<production-domain>/api/v1

# Email remains a pending provider decision before real password reset/notification mail.
EMAIL_PROVIDER=__PENDING_DECISION__
EMAIL_FROM_ADDRESS=
EMAIL_PROVIDER_API_KEY=

# Backup policy placeholders. Local dumps are supported; off-host storage is a pending operations decision.
BACKUP_DESTINATION=__PENDING_OFF_HOST_STORAGE__
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_REQUIRED=true