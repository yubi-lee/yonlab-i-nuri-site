{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yonlab:evidence-index:1.0.0",
  "title": "YOnLab release evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "source_commit", "generated_at_utc", "overall_status", "evidence"],
  "properties": {
    "schema_version": {"const": "evidence-index.v1"},
    "release": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(alpha|beta|rc)(0|[1-9][0-9]*))?$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "overall_status": {"enum": ["PASS", "FAIL", "BLOCKED", "MISSING", "REQUIRES_ACCEPTANCE_DATA"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "requirement_ids", "test_ids", "gate_ids", "status", "freshness", "artifact_path", "artifact_sha256", "source_commit", "executed_at_utc", "expires_at_utc", "owner_ids", "candidate_bound", "dependency_fingerprint"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"},
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(SYS-(F|NF)-[0-9]{3}|[A-Z]{3}-[0-9]{3})$"}},
        "test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^T-[A-Z0-9-]+$"}},
        "gate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^GATE-[A-Z-]+$"}},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "MISSING", "REQUIRES_ACCEPTANCE_DATA"]},
        "freshness": {"enum": ["FRESH", "STALE", "MISSING"]},
        "artifact_path": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*[:\\\\])[A-Za-z0-9._/-]+$"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "executed_at_utc": {"type": "string", "format": "date-time"},
        "expires_at_utc": {"type": "string", "format": "date-time"},
        "owner_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^OWN-[A-Z]+$"}},
        "candidate_bound": {"type": "boolean"},
        "dependency_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "x-fixture-contract": {"positive": "fixtures/evidence-index.valid.json", "negative": "fixtures/evidence-index.invalid.json", "negative_must_fail_keyword": "pattern"}
}
