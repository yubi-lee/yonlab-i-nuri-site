  "decision_contract": {
    "policy_version": "diagnosis-decision.v1",
    "invalid_evidence_rule": "INVALID_EVIDENCE is evaluated first when score is outside 0..100000000, confidence/conflict is outside 0..1000000, a numeric field is bool/non-integer, or required_indicators_satisfied is non-boolean",
    "score_range_microunit": [
      0,
      100000000
    ],
    "level_boundaries": [
      {
        "level": "L1",
        "minimum_score_microunit": 0,
        "maximum_score_microunit": 24999999
      },
      {
        "level": "L2",
        "minimum_score_microunit": 25000000,
        "maximum_score_microunit": 49999999
      },
      {
        "level": "L3",
        "minimum_score_microunit": 50000000,
        "maximum_score_microunit": 74999999
      },
      {
        "level": "L4",
        "minimum_score_microunit": 75000000,
        "maximum_score_microunit": 100000000
      }
    ],
    "confidence_threshold_microunit": 600000,
    "dimension_confidence_formula": "div_half_up(sum(indicator_weight_microunit * confidence_microunit), sum(indicator_weight_microunit))",
    "overall_confidence_formula": "div_half_up(sum(dimension_weight_microunit * dimension_confidence_microunit), sum(dimension_weight_microunit))",
    "conflict_formula": "max(div_half_up(SCALE * abs(anchor_a - anchor_b), anchor_count - 1)) for selected evidence pairs on the same indicator with distinct turn_sequence and confidence >= 600000",
    "conflict_threshold_microunit": 500000,
    "required_indicator_minimum_distinct_turns": 2,
    "required_indicator_minimum_confidence_microunit": 600000,
    "result_precedence": [
      "INVALID_EVIDENCE",
      "INSUFFICIENT_EVIDENCE",
      "HUMAN_REVIEW_REQUIRED",
      "ADDITIONAL_CONFIRMATION_REQUIRED",
      "LEVEL_ASSIGNED"
    ],
    "next_question_order": [
      "required_indicator_satisfied=false",
      "coverage_count ascending",
      "rubric_priority ascending",
      "question_id NFC UTF-8 bytewise ascending"
    ]
  },
