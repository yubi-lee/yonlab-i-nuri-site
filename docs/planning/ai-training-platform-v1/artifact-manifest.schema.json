{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yonlab:artifact-manifest:1.0.0",
  "title": "YOnLab release artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "release_state",
    "scope",
    "source_release_manifest_sha256",
    "source_commit",
    "source_tree_object_format",
    "source_tree",
    "source_tree_sha256",
    "baseline_id",
    "baseline_version",
    "baseline_sha256",
    "builder_image_digest",
    "source_date_epoch",
    "tool_versions",
    "files",
    "integrity_exclusions",
    "generated_at_utc",
    "signing_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "artifact-manifest.v1"
    },
    "release": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(alpha|beta|rc)(0|[1-9][0-9]*))?$"
    },
    "release_state": {
      "enum": [
        "NOT_READY",
        "CODE_COMPLETE / ACCEPTANCE DATA PENDING",
        "ACCEPTED"
      ]
    },
    "scope": {
      "enum": [
        "RELEASE",
        "DISTRIBUTION"
      ]
    },
    "source_release_manifest_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "source_tree_object_format": {
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "source_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_version": {
      "type": "string",
      "minLength": 1
    },
    "baseline_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "builder_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "tool_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      },
      "uniqueItems": true
    },
    "integrity_exclusions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exclusion"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "artifact-manifest.json"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "artifact-manifest.json.sig"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "SHA256SUMS.txt"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "SHA256SUMS.txt.sig"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "signing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "RELEASE"}}, "required": ["scope"]},
      "then": {"properties": {"source_release_manifest_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"scope": {"const": "DISTRIBUTION"}}, "required": ["scope"]},
      "then": {"properties": {"source_release_manifest_sha256": {"$ref": "#/$defs/sha256"}}}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^OWN-[A-Z]+$"
    },
    "gate": {
      "type": "string",
      "pattern": "^GATE-[A-Z-]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "size_bytes",
        "sha256",
        "owner_ids",
        "gate_ids",
        "source_paths"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/owner"
          }
        },
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePath"
          }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "enum": [
            "artifact-manifest.json",
            "artifact-manifest.json.sig",
            "SHA256SUMS.txt",
            "SHA256SUMS.txt.sig"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\\.|/|$))(?!.*[\\\\:%\\u0000-\\u001f\\u007f])(?!.*(?:^|/)[^/]*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
    }
  },
  "x-fixture-contract": {
    "positive": "fixtures/artifact-manifest.valid.json",
    "negative": "fixtures/artifact-manifest.invalid.json",
    "negative_must_fail_keyword": "required"
  },
  "x-semantic-contract": {
    "scope_containment": "RELEASE files are relative to docs/releases/ai-training-platform/{release}; DISTRIBUTION files are relative to dist/docs/{release}; neither manifest may cross its scope root",
    "distribution_provenance": "DISTRIBUTION source_release_manifest_sha256 MUST equal the verified RELEASE artifact-manifest.json SHA-256 for the same release",
    "file_path_uniqueness": "files[].path MUST be unique even when other row fields differ",
    "root_containment": "path and every source_paths item are NFC repository-relative POSIX paths with no traversal, control, percent, colon, backslash, Windows device name, or trailing dot/space segment",
    "content_nonempty": "size_bytes MUST be >= 1",
    "fixture_release_root": "fixtures/artifact-root/release",
    "fixture_source_root": "fixtures/artifact-root/source",
    "actual_bytes": "For every fixture files[] row, size_bytes and sha256 MUST equal the bytes at fixture_release_root/path",
    "source_resolution": "Every fixture source_paths[] item MUST resolve to a nonempty regular file below fixture_source_root",
    "owner_gate_resolution": "Every owner_ids/gate_ids member MUST resolve to the canonical requirement registry/release gate catalog",
    "reproducible_timestamp": "generated_at_utc MUST equal the RFC3339 UTC instant represented by source_date_epoch",
    "fixtures": {
      "invalid_duplicate_path": "fixtures/artifact-manifest.invalid-duplicate-path.json",
      "invalid_source_path": "fixtures/artifact-manifest.invalid-source-path.json"
    }
  }
}
